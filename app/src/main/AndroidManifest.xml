<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".WordMasterApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordMaster">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.upload.UploadActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.learn.LearnActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.review.ReviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.book.BookDetailActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

    </application>

</manifest>
